********* SOLUTION
********* Mode: in_out_copia
********* Scoping: static

     call p1[]     
          a=0 ->	a:p1 = 0
          b=2 ->	b:p1 = 2
          c=4 ->	c:p1 = 4
          d=1 ->	d:p1 = 1
     call p4[b,a]     in_out_rif a <- b; in_out_copia d <- a; 
          b=c*2 ->	b:p4 = 8
          a=a*3 ->	a:p4 = b:p1 = 6
          d=d+3 ->	d:p4 = 3
          c=1 ->	c:p1 = 1
     call p2[d]     in_out_copia c <- d; 
          d=3 ->	d:p2 = 3
          b=2 ->	b:p2 = 2
          c=a ->	c:p2 = 0
          a=b*1 ->	a:p1 = 2
     call p3[c,d]     in_out_rif d <- c; in_out_copia b <- d; 
          c=d ->	c:p3 = 0
          d=1 ->	d:p3 = c:p2 = 1
          b=a+1 ->	b:p3 = 3
          a=b ->	a:p1 = 3
          write[a,b,c,d]
3 3 0 1 
     leaving p3, back to p2
               copy b back -> d:p2 = 3
          write[a,b,c,d]
3 2 1 3 
     leaving p2, back to p4
               copy c back -> d:p4 = 1
          write[a,b,c,d]
6 8 1 1 
     leaving p4, back to p1
               copy d back -> a:p1 = 1
          write[a,b,c,d]
1 6 1 1 
     leaving p1

