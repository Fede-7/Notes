********* SOLUTION
********* Mode: in_copia
********* Scoping: static

     call p1[]     
          a=4 ->	a:p1 = 4
          b=4 ->	b:p1 = 4
          c=1 ->	c:p1 = 1
          d=1 ->	d:p1 = 1
     call p2[c]     in_copia a <- c; 
          d=3 ->	d:p2 = 3
          a=1 ->	a:p2 = 1
          c=3 ->	c:p1 = 3
          b=d*2 ->	b:p1 = 6
     call p3[d]     in_copia c <- d; 
          a=d ->	a:p3 = 3
          c=d-2 ->	c:p3 = 1
          d=4 ->	d:p2 = 4
          b=b*4 ->	b:p1 = 24
     call p4[a]     in_copia c <- a; 
          a=b ->	a:p4 = 24
          c=2 ->	c:p4 = 2
          b=c+1 ->	b:p1 = 3
          d=c ->	d:p2 = 2
          write[a,b,c,d]
24 3 2 2 
     leaving p4, back to p3
          write[a,b,c,d]
3 3 1 2 
     leaving p3, back to p2
          write[a,b,c,d]
1 3 3 2 
     leaving p2, back to p1
          write[a,b,c,d]
4 3 3 1 
     leaving p1

