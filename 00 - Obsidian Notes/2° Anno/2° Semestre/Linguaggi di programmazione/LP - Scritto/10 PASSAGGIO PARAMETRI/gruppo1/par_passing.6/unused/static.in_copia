********* SOLUTION
********* Mode: in_copia
********* Scoping: static

     call p1[]     
          a=4 ->	a:p1 = 4
          b=3 ->	b:p1 = 3
          c=4 ->	c:p1 = 4
          d=0 ->	d:p1 = 0
     call p2[a]     in_copia b <- a; 
          c=d*2 ->	c:p2 = 0
          b=d ->	b:p2 = 0
          d=1 ->	d:p1 = 1
          a=3 ->	a:p1 = 3
     call p3[c]     in_out_copia a <- c; 
          c=d-1 ->	c:p3 = 0
          a=1 ->	a:p3 = 1
          d=d-3 ->	d:p1 = -2
          b=2 ->	b:p2 = 2
     call p4[a]     in_copia b <- a; 
          a=b ->	a:p4 = 1
          b=2 ->	b:p4 = 2
          d=4 ->	d:p1 = 4
          c=3 ->	c:p2 = 3
          write[a,b,c,d]
1 2 3 4 
     leaving p4, back to p3
          write[a,b,c,d]
1 2 0 4 
     leaving p3, back to p2
               copy a back -> c:p2 = 1
          write[a,b,c,d]
3 2 1 4 
     leaving p2, back to p1
          write[a,b,c,d]
3 3 4 4 
     leaving p1

