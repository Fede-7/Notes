********* SOLUTION
********* Mode: out_copia
********* Scoping: dynamic

     call p1[]     
          x=4 ->	x:p1 = 4
          y=4 ->	y:p1 = 4
          z=1 ->	z:p1 = 1
          t=2 ->	t:p1 = 2
     call p2[x]     out_copia z <- x; 
          y=x*1 ->	y:p2 = 4
          z=4 ->	z:p2 = 4
          t=x ->	t:p1 = 4
          x=1 ->	x:p1 = 1
     call p3[y]     in_out_copia x <- y; 
          t=y*3 ->	t:p3 = 12
          x=t ->	x:p3 = 12
          y=y ->	y:p2 = 4
          z=2 ->	z:p2 = 2
     call p4[z,t]     in_out_copia y <- z; in_out_copia t <- t; 
          z=x*3 ->	z:p4 = 36
          y=z+3 ->	y:p4 = 39
          t=x ->	t:p4 = 12
          x=2 ->	x:p3 = 2
          write[x,y,z,t]
2 39 36 12 
     leaving p4, back to p3
               copy y back -> z:p2 = 39
               copy t back -> t:p3 = 12
          write[x,y,z,t]
2 4 39 12 
     leaving p3, back to p2
               copy x back -> y:p2 = 2
          write[x,y,z,t]
1 2 39 4 
     leaving p2, back to p1
               copy z back -> x:p1 = 39
          write[x,y,z,t]
39 4 1 4 
     leaving p1

