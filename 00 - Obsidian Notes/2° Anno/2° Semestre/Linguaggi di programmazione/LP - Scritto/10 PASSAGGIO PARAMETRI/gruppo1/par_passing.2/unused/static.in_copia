********* SOLUTION
********* Mode: in_copia
********* Scoping: static

     call p1[]     
          x=3 ->	x:p1 = 3
          y=2 ->	y:p1 = 2
          z=4 ->	z:p1 = 4
          t=3 ->	t:p1 = 3
     call p2[y]     in_copia y <- y; 
          z=3 ->	z:p2 = 3
          y=2 ->	y:p2 = 2
          t=y+3 ->	t:p1 = 5
          x=x ->	x:p1 = 3
     call p3[t]     in_copia z <- t; 
          x=y ->	x:p3 = 2
          t=z ->	t:p3 = 5
          z=4 ->	z:p3 = 4
          y=x ->	y:p1 = 2
     call p4[y,z]     in_copia x <- y; in_out_copia t <- z; 
          z=x ->	z:p4 = 2
          x=z-3 ->	x:p4 = -1
          t=4 ->	t:p4 = 4
          y=2 ->	y:p1 = 2
          write[x,y,z,t]
-1 2 2 4 
     leaving p4, back to p3
               copy t back -> z:p3 = 4
          write[x,y,z,t]
2 2 4 5 
     leaving p3, back to p2
          write[x,y,z,t]
3 2 3 5 
     leaving p2, back to p1
          write[x,y,z,t]
3 2 4 5 
     leaving p1

