********* SOLUTION
********* Mode: in_copia
********* Scoping: static

     call p1[]     
          q=4 ->	q:p1 = 4
          r=1 ->	r:p1 = 1
          s=2 ->	s:p1 = 2
          t=2 ->	t:p1 = 2
     call p4[t]     in_out_rif q <- t; 
          t=q+2 ->	t:p4 = 4
          q=3 ->	q:p4 = t:p1 = 3
          s=r ->	s:p1 = 1
          r=r+1 ->	r:p1 = 2
     call p2[s,t]     in_copia q <- s; in_copia s <- t; 
          r=3 ->	r:p2 = 3
          q=t ->	q:p2 = 3
          s=2 ->	s:p2 = 2
          t=1 ->	q:p4 = t:p1 = 1
     call p3[t]     in_out_copia t <- t; 
          s=1 ->	s:p3 = 1
          r=3 ->	r:p3 = 3
          t=t ->	t:p3 = 1
          q=4 ->	q:p2 = 4
          write[q,r,s,t]
4 3 1 1 
     leaving p3, back to p2
               copy t back -> q:p4 = t:p1 = 1
          write[q,r,s,t]
4 3 2 1 
     leaving p2, back to p4
          write[q,r,s,t]
1 2 1 4 
     leaving p4, back to p1
          write[q,r,s,t]
4 2 1 1 
     leaving p1

