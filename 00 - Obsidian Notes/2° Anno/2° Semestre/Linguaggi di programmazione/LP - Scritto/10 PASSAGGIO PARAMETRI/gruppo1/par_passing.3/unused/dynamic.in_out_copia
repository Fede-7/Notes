********* SOLUTION
********* Mode: in_out_copia
********* Scoping: dynamic

     call p1[]     
          x=4 ->	x:p1 = 4
          y=4 ->	y:p1 = 4
          z=2 ->	z:p1 = 2
          t=2 ->	t:p1 = 2
     call p2[t]     in_out_copia x <- t; 
          y=3 ->	y:p2 = 3
          x=y ->	x:p2 = 3
          t=t ->	t:p1 = 2
          z=y ->	z:p1 = 3
     call p3[y]     in_out_copia z <- y; 
          y=x+4 ->	y:p3 = 7
          t=3 ->	t:p3 = 3
          z=x*4 ->	z:p3 = 12
          x=2 ->	x:p2 = 2
     call p4[z]     in_out_copia x <- z; 
          y=3 ->	y:p4 = 3
          t=3 ->	t:p4 = 3
          x=z*4 ->	x:p4 = 48
          z=4 ->	z:p3 = 4
          write[x,y,z,t]
48 3 4 3 
     leaving p4, back to p3
               copy x back -> z:p3 = 48
          write[x,y,z,t]
2 7 48 3 
     leaving p3, back to p2
               copy z back -> y:p2 = 48
          write[x,y,z,t]
2 48 3 2 
     leaving p2, back to p1
               copy x back -> t:p1 = 2
          write[x,y,z,t]
4 4 3 2 
     leaving p1

