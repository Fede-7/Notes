summaries:
  Empty: values.filter(value.isType("null")).length
  Filled: values.filter(!value.isType("null")).length
formulas:
  Senza titolo: file.folder.replace(/^.*\//, "")
properties:
  formula.Senza titolo:
    displayName: Nome cartella
views:
  - type: table
    name: Tabella Semestre
    filters:
      and:
        - file.inFolder("00 - Obsidian Notes/3° Anno/1° Semestre")
        - '!file.inFolder("00 - Obsidian Notes/3° Anno/1° Semestre/Reti/Spunto")'
        - file.ext != "png"
    order:
      - file.name
      - formula.Senza titolo
    sort:
      - property: Date
        direction: DESC
      - property: Professore
        direction: DESC
      - property: file.ctime
        direction: DESC
    summaries: {}
    columnSize:
      note.Date: 166
  - type: table
    name: Last notes
  - type: cards
    name: Home-Corsi
    filters:
      and:
        - file.inFolder("00 - Obsidian Notes/Home-Settings")
        - and:
            - file.name != "Home"
    order:
      - file.name
    cardSize: 140
    imageAspectRatio: 1
    indentProperties: false
